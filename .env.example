# Local cross-platform settings.

DEFAULT_TIMEZONE=local
LOG_LEVEL=INFO
DEV_MODE=true
AUTO_OPEN_BROWSER=false

EMAIL_APP_HOST=127.0.0.1
EMAIL_APP_PORT=8011
EMAIL_APP_DB_PATH=data/email.db

EMAIL_MCP_HOST=127.0.0.1
EMAIL_MCP_PORT=8111
EMAIL_MCP_STREAMABLE_HTTP_PATH=/mcp
EMAIL_MCP_EMAIL_API_SCHEME=http
EMAIL_MCP_EMAIL_API_HOST=127.0.0.1
EMAIL_MCP_EMAIL_API_PORT=8011
EMAIL_MCP_EMAIL_API_MESSAGES_PATH=/api/messages
EMAIL_MCP_EMAIL_API_TIMEOUT_SECONDS=5.0

TODO_APP_HOST=127.0.0.1
TODO_APP_PORT=8012
TODO_APP_DB_PATH=data/todo.db

CALENDAR_APP_HOST=127.0.0.1
CALENDAR_APP_PORT=8013
CALENDAR_APP_DB_PATH=data/calendar.db

AGENT_CHECKPOINT_DB_PATH=data/agent_checkpoints.db
AGENT_AUDIT_DB_PATH=data/agent_debug.db

# Agent LLM provider.
# Supported AGENT_LLM_PROVIDER values:
# - ollama: local Ollama runtime; uses AGENT_OLLAMA_BASE_URL and AGENT_LLM_MODEL.
# - openai: OpenAI API; uses AGENT_OPENAI_API_KEY and AGENT_LLM_MODEL.
AGENT_LLM_PROVIDER=ollama
AGENT_LLM_MODEL=gemma4:31b
AGENT_LLM_TEMPERATURE=0.0
AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_OPENAI_API_KEY=
AGENT_STUDIO_USE_REAL_RUNTIME=false
